{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "tolu-learnjenkins-app_prod",
    "containerDefinitions": [
        {
            "name": "learn-jenkinsapp-prod",
            "image": "nginx:1.29-bookworm-otel",
            "portMappings": [{
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": ""
}