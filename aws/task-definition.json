{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "tolu-learnjenkins-app_prod",
    "containerDefinitions": [
        {
            "name": "learnjenkinsappprod",
            "image": "nginx:1.29-alpine3.22-perl",
            "portMappings": [{
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512 MiB",
    "cpu": ".25 vCPU",
    "executionRoleArn": ""
}